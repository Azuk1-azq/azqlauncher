<Window x:Class="AZQLAUNCHER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AZQLAUNCHER" Icon="Assets/app.ico" Height="652" Width="992"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI, Meiryo UI" TextOptions.TextFormattingMode="Ideal"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown" PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged"
        ResizeMode="CanResize" MinWidth="860" MinHeight="600">

    <Border Margin="16" CornerRadius="16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource WinBg1Color}" Offset="0"/>
                <GradientStop Color="{DynamicResource WinBg2Color}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.65" Direction="270" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Grid Width="28" Height="28" Margin="0,0,11,0">
                        <Border Width="21" Height="21" CornerRadius="5" Background="{StaticResource AccentGradient}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="14"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource LogoHoleBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="14"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock Text="AZQLAUNCHER" Foreground="{DynamicResource TextBrush}" FontFamily="Bahnschrift, Segoe UI" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="7,2" Margin="12,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="beta0.0.5" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="−" Style="{StaticResource WindowButton}" FontSize="16" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource CloseButton}" Margin="4,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- メインレイアウト -->
            <Grid Grid.Row="1" Margin="15,0,15,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="214"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- サイドバーメニュー -->
                <Grid Grid.Column="0" Margin="0,10,14,0">
                    <StackPanel VerticalAlignment="Top">
                    <Button x:Name="NavDashboard" Tag="Active" Content="🎮 ダッシュボード" Style="{StaticResource MenuButton}" Height="44" Margin="0,0,0,4" Click="Nav_Click"/>
                    <Button x:Name="NavFastFlags" Content="⚡ FastFlags" Style="{StaticResource MenuButton}" Height="44" Margin="0,0,0,4" Click="Nav_Click"/>
                    <Button x:Name="NavMods" Content="🎨 スカイボックス・Mods" Style="{StaticResource MenuButton}" Height="44" Margin="0,0,0,4" Click="Nav_Click"/>
                    <Button x:Name="NavLogs" Content="📜 ログ" Style="{StaticResource MenuButton}" Height="44" Margin="0,0,0,4" Click="Nav_Click"/>
                    <Button x:Name="NavSettings" Content="⚙️ 設定" Style="{StaticResource MenuButton}" Height="44" Margin="0,0,0,4" Click="Nav_Click"/>
                </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock x:Name="SidebarStatusText" Text="Roblox" Foreground="{DynamicResource TextSoftBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnSidebarLaunch" Content="▶ 起動" Style="{StaticResource PrimaryButton}" Height="46" FontSize="14" Click="LaunchRoblox_Click"/>
                    </StackPanel>
                </Grid>

                <!-- コンテンツエリア -->
                <Border Grid.Column="1" Background="{DynamicResource ContentBgBrush}" CornerRadius="14" BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="1" Padding="26">
                    <Grid>
                        <!-- ================= DASHBOARD ================= -->
                        <ScrollViewer x:Name="PageDashboard" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border CornerRadius="16" Padding="30,28" ClipToBounds="True" BorderThickness="1" BorderBrush="#FF2A3150">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF1C2455" Offset="0"/>
                                            <GradientStop Color="#FF161B38" Offset="0.55"/>
                                            <GradientStop Color="#FF121626" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Canvas Width="300" Height="220" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-70,0" IsHitTestVisible="False">
                                            <Border Canvas.Left="120" Canvas.Top="14" Width="170" Height="170" BorderThickness="24" CornerRadius="8" Opacity="0.55" RenderTransformOrigin="0.5,0.5" BorderBrush="{StaticResource AccentGradient}">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="15"/>
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border Canvas.Left="40" Canvas.Top="110" Width="92" Height="92" BorderThickness="13" CornerRadius="5" Opacity="0.32" RenderTransformOrigin="0.5,0.5" BorderBrush="#FF8B5CFF">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="-13"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Canvas>

                                        <StackPanel>
                                            <TextBlock x:Name="LblQuickLaunchTitle" Text="クイック起動" Foreground="White" FontFamily="Bahnschrift, Segoe UI" FontSize="32" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="LblDashSub" Text="設定を適用してRobloxを起動します" Foreground="#FFA9B2D0" FontSize="13" Margin="0,6,0,24"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnLaunchRoblox" Content="▶ Robloxを直接起動" Style="{StaticResource PrimaryButton}" Width="240" Height="52" FontSize="15" Click="LaunchRoblox_Click"/>
                                                <Button x:Name="BtnLaunchVanilla" Content="⏩ ランチャーを通さないで起動" Style="{StaticResource SecondaryButton}" Width="252" Height="52" Margin="12,0,0,0" FontSize="14" Click="LaunchVanilla_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LblDashClientTitle" Text="Roblox クライアント" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                            <TextBlock x:Name="DashClientText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="6,0,6,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LblDashFlagsTitle" Text="FastFlags" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                            <TextBlock x:Name="DashFlagsText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LblDashModsTitle" Text="Mods" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                            <TextBlock x:Name="DashModsText" Text="-" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            
                                <!-- クイック参加 -->
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="LblQuickJoinTitle" Text="クイック参加" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Background="{StaticResource AccentGradient}" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="LblQuickJoinBadge" Text="ゲーム名を入れるだけ" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="LblQuickJoinHint" Text="ゲーム名 (日本語・英語OK) を入力するだけで、候補から選んで直接参加できます。URL・プレイスID・プライベートサーバーのリンクも使えます" Foreground="{DynamicResource TextSoftBrush}" FontSize="12" Margin="0,6,0,10" TextWrapping="Wrap"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtQuickJoin" Grid.Column="0" Height="38" Padding="10,9" KeyDown="TxtQuickJoin_KeyDown" PreviewKeyDown="TxtQuickJoin_PreviewKeyDown" TextChanged="TxtQuickJoin_TextChanged" LostKeyboardFocus="TxtQuickJoin_LostKeyboardFocus"/>
                                            <!-- 空のときだけ表示するプレースホルダー -->
                                            <TextBlock x:Name="LblQuickJoinPlaceholder" Grid.Column="0" Text="ゲーム名を入力 (例: Blox Fruits / ブロックスフルーツ)" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                                       Margin="12,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TxtQuickJoin}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button x:Name="BtnQuickJoin" Grid.Column="1" Content="参加" Style="{StaticResource PrimaryButton}" Width="96" Height="38" Margin="10,0,0,0" Click="QuickJoin_Click"/>
                                        </Grid>
                                        <!-- ゲーム名検索の候補 (入力欄の真下に表示) -->
                                        <Border x:Name="SuggestPanel" Visibility="Collapsed" Margin="0,6,0,0" Padding="4" CornerRadius="9"
                                                        Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1">
                                                  <StackPanel>
                                                    <!-- 検索中の表示 -->
                                                    <StackPanel x:Name="SuggestLoadingRow" Orientation="Horizontal" Margin="10,9" Visibility="Collapsed">
                                                        <Ellipse Width="14" Height="14" StrokeThickness="2" Stroke="{DynamicResource AccentTextBrush}" StrokeDashArray="6 13" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                                            <Ellipse.RenderTransform>
                                                                <RotateTransform x:Name="SuggestSpinnerRotate"/>
                                                            </Ellipse.RenderTransform>
                                                            <Ellipse.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="SuggestSpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Ellipse.Triggers>
                                                        </Ellipse>
                                                        <TextBlock x:Name="LblSuggestLoading" Text="読み込み中…" Foreground="{DynamicResource TextSoftBrush}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ListBox x:Name="SuggestList" MaxHeight="280" Background="Transparent" BorderThickness="0" Focusable="False"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Focusable" Value="False"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SuggestItem_MouseDown"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                            <Border x:Name="Bd" CornerRadius="6" Padding="10,7" Background="Transparent">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding PlayersText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                  </StackPanel>
                                                </Border>
                                        <TextBlock x:Name="QuickJoinStatusText" Text="" Foreground="{DynamicResource ErrBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="LblRecentTitle" Text="最近のゲーム" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,12,0,0"/>
                                        <WrapPanel x:Name="RecentGamesPanel" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= FASTFLAGS ================= -->
                        <Grid x:Name="PageFastFlags" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="LblFastFlagsTitle" Text="FastFlags" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="LblFastFlagsSub" Text="ホワイトリスト準拠の安全なクライアント設定" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="FastFlagsSaveStatusText" Text="" Foreground="{DynamicResource InfoBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button x:Name="BtnResetFastFlags" Content="リセット" Style="{StaticResource SecondaryButton}" Height="36" Click="ResetFastFlags_Click"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,10,0">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="LblPerfCardTitle" Text="パフォーマンス・フレームレート" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                            <CheckBox x:Name="ChkUnlockFPS" Content="FPS上限を解放する" Margin="0,0,0,10" Checked="FastFlagUi_Changed" Unchecked="FastFlagUi_Changed"/>

                                            <StackPanel Orientation="Horizontal" Margin="24,0,0,12">
                                                <TextBlock x:Name="LblTargetFps" Text="目標FPS上限:" Foreground="{DynamicResource TextSoftBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox x:Name="TxtTargetFps" Width="90" Height="28" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" Padding="6,3" Text="9999" TextChanged="FastFlagUi_Changed" LostFocus="TxtTargetFps_LostFocus"/>
                                                <Button Content="60" Tag="60" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Margin="10,0,0,0" FontSize="12" Click="FpsPreset_Click"/>
                                                <Button Content="144" Tag="144" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Margin="6,0,0,0" FontSize="12" Click="FpsPreset_Click"/>
                                                <Button Content="240" Tag="240" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Margin="6,0,0,0" FontSize="12" Click="FpsPreset_Click"/>
                                                <Button x:Name="BtnFpsUnlimited" Content="無制限" Tag="9999" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Margin="6,0,0,0" FontSize="12" Click="FpsPreset_Click"/>
                                            </StackPanel>

                                            <CheckBox x:Name="ChkDisablePostFx" Content="PostFX (ブルーム・被写界深度等の重いエフェクト) を無効化" Margin="0,0,0,10" Checked="FastFlagUi_Changed" Unchecked="FastFlagUi_Changed"/>
                                            <CheckBox x:Name="ChkLowRenderQuality" Content="レンダリング品質を軽量化 (FRM品質レベル1固定)" Checked="FastFlagUi_Changed" Unchecked="FastFlagUi_Changed"/>
                                            <TextBlock x:Name="LblFlagNote" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="LblLargeCardTitle" Text="大人数サーバー向けの軽量化" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="LblLargeNote" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                            <Button x:Name="BtnLargePreset" Content="⚡ 大人数向けプリセットを適用" Style="{StaticResource PrimaryButton}" Height="34" HorizontalAlignment="Left" Padding="14,0" Margin="0,0,0,12" Click="LargeServerPreset_Click"/>
                                            <CheckBox x:Name="ChkLowTexture" Content="テクスチャ品質を最低にする" Margin="0,0,0,8" Checked="FastFlagUi_Changed" Unchecked="FastFlagUi_Changed"/>
                                            <CheckBox x:Name="ChkDisableMsaa" Content="アンチエイリアス (MSAA) を切る" Margin="0,0,0,8" Checked="FastFlagUi_Changed" Unchecked="FastFlagUi_Changed"/>
                                            <CheckBox x:Name="ChkReduceGrass" Content="草の描画をなくす" Margin="0,0,0,8" Checked="FastFlagUi_Changed" Unchecked="FastFlagUi_Changed"/>
                                            <CheckBox x:Name="ChkAggressiveLod" Content="遠くのモデルを早めに簡略化する" Margin="0,0,0,8" Checked="FastFlagUi_Changed" Unchecked="FastFlagUi_Changed"/>
                                            <CheckBox x:Name="ChkPauseVoxelizer" Content="ライティングの更新を停止" Margin="0,0,0,8" Checked="FastFlagUi_Changed" Unchecked="FastFlagUi_Changed"/>
                                            <CheckBox x:Name="ChkHighPriority" Content="RobloxのCPU優先度を高にする" Checked="FastFlagUi_Changed" Unchecked="FastFlagUi_Changed"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="LblGraphicsCardTitle" Text="グラフィックス・レンダリング" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="LblGraphicsApi" Grid.Column="0" Text="描画エンジン (API):" Foreground="{DynamicResource TextSoftBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="CmbGraphicsApi" Grid.Column="1" Width="200" Height="30" HorizontalAlignment="Left" SelectionChanged="FastFlagUi_SelectionChanged">
                                                    <ComboBoxItem x:Name="CmbApiAuto" Content="自動 (デフォルト)" Tag="Auto"/>
                                                    <ComboBoxItem Content="Direct3D 11" Tag="D3D11"/>
                                                    <ComboBoxItem Content="Direct3D 10" Tag="D3D10"/>
                                                    <ComboBoxItem Content="Vulkan" Tag="Vulkan"/>
                                                    <ComboBoxItem Content="OpenGL" Tag="OpenGL"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock x:Name="LblCustomFlagsTitle" Text="フラグ管理" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="🔍" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox x:Name="TxtFlagSearch" Width="170" Height="28" Padding="6,3" TextChanged="TxtFlagSearch_TextChanged"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="LblFlagMgrHint" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                            <StackPanel x:Name="FlagListPanel"/>
                                            <TextBlock x:Name="FlagEmptyText" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,4,0,8"/>

                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,6,0,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="LblAddFlagTitle" Text="フラグを追加" Foreground="{DynamicResource TextSoftBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox x:Name="CmbAddFlag" Grid.Column="0" Height="30" Margin="0,0,8,0" SelectionChanged="CmbAddFlag_SelectionChanged"/>
                                                        <TextBox x:Name="TxtAddFlagValue" Grid.Column="1" Width="90" Height="30" Padding="6,3" Margin="0,0,8,0" KeyDown="AddFlag_KeyDown"/>
                                                        <Button x:Name="BtnAddFlag" Grid.Column="2" Content="追加" Style="{StaticResource PrimaryButton}" Height="30" Padding="14,0" Click="BtnAddFlag_Click"/>
                                                    </Grid>
                                                    <TextBox x:Name="TxtAddFlagName" Height="30" Padding="6,3" Margin="0,8,0,0" FontFamily="Consolas" KeyDown="AddFlag_KeyDown"/>
                                                    <TextBlock x:Name="LblAddFlagDesc" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <Button x:Name="BtnToggleJson" Content="{}  JSONを直接編集 ▼" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ToggleJson_Click"/>
                                            <StackPanel x:Name="JsonEditorPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock x:Name="LblJsonEditorTitle" Text="JSONエディタ (上のリストと同期します)" Foreground="{DynamicResource TextSoftBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    <Button x:Name="BtnFormatJson" Content="JSON整形" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" HorizontalAlignment="Right" Click="FormatJson_Click"/>
                                                </Grid>
                                                <TextBox x:Name="TxtCustomFlags" Height="130" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource OkBrightBrush}" FontFamily="Consolas" FontSize="12"
                                                         Padding="10" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                         Text="{}{&#x0a;  &quot;DFIntTaskSchedulerTargetFps&quot;: 240&#x0a;}" TextChanged="TxtCustomFlags_TextChanged"/>
                                                <TextBlock x:Name="JsonStatusText" Text="JSONステータス: 正常" Foreground="{DynamicResource OkBrush}" FontSize="12" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ================= MODS & SKYBOX ================= -->
                        <ScrollViewer x:Name="PageMods" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="LblModsTitle" Text="カーソル・死亡音・スカイボックス・Mods" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="LblModsNote" Text="変更は次回のRoblox起動時に反映されます。" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                <CheckBox x:Name="ChkEnableMods" Content="カスタムMods・外観変更をRoblox起動時に自動適用する" FontWeight="Bold" Margin="0,0,0,15" Checked="Setting_Changed" Unchecked="Setting_Changed"/>

                                <!-- カーソル設定カード -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LblCursorTitle" Text="🖱️ マウスカーソル" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                        <RadioButton x:Name="RbCursorSystem" GroupName="CursorMode" Content="マウスカーソルそのまま (Windowsで設定している現在のカーソルを使用)" Margin="0,0,0,8" Checked="CursorMode_Changed"/>
                                        <RadioButton x:Name="RbCursorDefault" GroupName="CursorMode" Content="Roblox標準カーソル" Margin="0,0,0,8" Checked="CursorMode_Changed"/>
                                        <RadioButton x:Name="RbCursorClassic" GroupName="CursorMode" Content="昔のマウスカーソル (2013年以前のクラシックカーソル)" Margin="0,0,0,8" Checked="CursorMode_Changed"/>
                                        <RadioButton x:Name="RbCursorCustom" GroupName="CursorMode" Content="カスタム画像 (.png) を使用" Margin="0,0,0,10" Checked="CursorMode_Changed"/>

                                        <StackPanel x:Name="CustomCursorFilePanel" Orientation="Horizontal" Margin="22,0,0,0">
                                            <Button x:Name="BtnSelectCursor" Content="カーソル画像 (.png) を選択" Style="{StaticResource SecondaryButton}" Click="SelectCursor_Click"/>
                                            <Button x:Name="BtnClearCursor" Content="解除" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearCursor_Click"/>
                                            <TextBlock x:Name="CursorPathText" Text="未設定" Foreground="{DynamicResource TextSoftBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 死亡音設定カード -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LblSoundTitle" Text="🔊 死亡時の効果音 (Oof / 任意の音声自動変換)" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnClassicOof" Content="クラシック Oof 音を設定" Style="{StaticResource PrimaryButton}" Click="SetClassicOof_Click"/>
                                            <Button x:Name="BtnSelectDeathSound" Content="音声ファイルを選択 (.mp3 / .wav / .ogg等)" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="SelectDeathSound_Click"/>
                                            <Button x:Name="BtnClearSound" Content="解除" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearDeathSound_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DeathSoundPathText" Text="現在の設定: 未設定 (Roblox標準)" Foreground="{DynamicResource TextSoftBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- スカイボックス設定カード -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LblSkyTitle" Text="🌌 カスタム スカイボックス (bk, dn, ft, lf, rt, up)" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnSelectSky" Content="スカイボックスフォルダを選択" Style="{StaticResource SecondaryButton}" Click="SelectSkybox_Click"/>
                                            <Button x:Name="BtnClearSky" Content="解除" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearSkybox_Click"/>
                                            <TextBlock x:Name="SkyboxPathText" Text="未設定" Foreground="{DynamicResource TextSoftBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- フォント設定カード -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LblFontTitle" Text="🔤 カスタム フォント (.ttf / .otf)" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnSelectFont" Content="フォントファイルを選択" Style="{StaticResource SecondaryButton}" Click="SelectFont_Click"/>
                                            <Button x:Name="BtnClearFont" Content="解除" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearFont_Click"/>
                                            <TextBlock x:Name="FontPathText" Text="未設定" Foreground="{DynamicResource TextSoftBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 汎用Modsフォルダ -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblModsFolderTitle" Text="📁 汎用 Mods フォルダ" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Button x:Name="BtnOpenMods" Content="Modsフォルダを開く" Style="{StaticResource SecondaryButton}" Width="180" HorizontalAlignment="Left" Click="OpenModsFolder_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= LOGS ================= -->
                        <Grid x:Name="PageLogs" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock x:Name="LblLogsTitle" Text="実行ログ" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnCopyLogs" Content="コピー" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CopyLogs_Click"/>
                                    <Button x:Name="BtnClearLogs" Content="クリア" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ClearLogs_Click"/>
                                    <Button x:Name="BtnOpenRobloxLogs" Content="📂 Robloxログ" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenRobloxLogsFolder_Click"/>
                                    <Button x:Name="BtnOpenLauncherLogs" Content="📂 ランチャーログ" Style="{StaticResource SecondaryButton}" Click="OpenLauncherLogsFolder_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBox x:Name="TxtLogs" Grid.Row="1" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextSoftBrush}" FontFamily="Consolas" FontSize="12"
                                     Padding="12" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>

                        <!-- ================= SETTINGS ================= -->
                        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="LblSettingsTitle" Text="ランチャー設定" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                                <!-- 表示 -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LblAppearanceTitle" Text="表示" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblLanguage" Grid.Column="0" Text="表示言語 (Language):" Foreground="{DynamicResource TextSoftBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbLanguage" Grid.Column="1" Width="260" Height="32" HorizontalAlignment="Left" SelectionChanged="CmbLanguage_SelectionChanged">
                                                <ComboBoxItem x:Name="CmbLangSystem" Content="システム言語 (自動)" Tag="System"/>
                                                <ComboBoxItem Content="日本語 (Japanese)" Tag="ja"/>
                                                <ComboBoxItem Content="English (英語)" Tag="en"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblTheme" Grid.Column="0" Text="テーマ:" Foreground="{DynamicResource TextSoftBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbTheme" Grid.Column="1" Width="260" Height="32" HorizontalAlignment="Left" SelectionChanged="CmbTheme_SelectionChanged">
                                                <ComboBoxItem x:Name="CmbThemeSystem" Content="システム設定に合わせる (推奨)" Tag="System"/>
                                                <ComboBoxItem x:Name="CmbThemeDark" Content="ダーク" Tag="Dark"/>
                                                <ComboBoxItem x:Name="CmbThemeLight" Content="ライト" Tag="Light"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 起動の動作 -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LblLaunchSectionTitle" Text="起動の動作" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                                        <CheckBox x:Name="ChkAutoClose" Content="Robloxの起動完了後にランチャーを自動で閉じる" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <TextBlock x:Name="DescAutoClose" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="52,3,0,16"/>

                                        <CheckBox x:Name="ChkMinimizeToTray" Content="最小化したときトレイに格納する" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <TextBlock x:Name="DescMinimizeToTray" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="52,3,0,16"/>

                                        <CheckBox x:Name="ChkBypassLauncher" Content="ブラウザから起動時もランチャーを通さないで標準起動する" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <TextBlock x:Name="DescBypassLauncher" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="52,3,0,16"/>

                                        <CheckBox x:Name="ChkCleanClientSettings" Content="Roblox起動前に古いClientAppSettingsをクリーンアップする" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <TextBlock x:Name="DescCleanClientSettings" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="52,3,0,2"/>
                                    </StackPanel>
                                </Border>

                                <!-- カーソル -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkProtectCursor" Content="カスタムカーソルの適用を維持する" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <TextBlock x:Name="DescProtectCursor" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="52,3,0,2"/>
                                    </StackPanel>
                                </Border>

                                <!-- ブラウザ連携 -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LblProtocolTitle" Text="ブラウザ連携 (URIプロトコル)" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="ChkAutoRegisterProtocol" Content="ランチャー起動時にブラウザ連携を自動登録する" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <TextBlock x:Name="DescAutoRegisterProtocol" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="52,3,0,16"/>
                                        <TextBlock x:Name="ProtocolStatusText" Text="状態: 確認中..." Foreground="{DynamicResource OkBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <Button x:Name="BtnReRegisterProtocol" Content="ブラウザ連携を手動で再登録" Style="{StaticResource SecondaryButton}" Width="220" Height="36" HorizontalAlignment="Left" Click="RegisterProtocol_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- メンテナンス -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblMaintenanceTitle" Text="メンテナンス・情報" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <WrapPanel>
                                            <Button x:Name="BtnOpenRobloxFolder" Content="Robloxのクライアントフォルダを開く" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,10" Click="OpenRobloxFolder_Click"/>
                                            <Button x:Name="BtnRestoreMods" Content="Modsを元に戻す" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,10" Click="RestoreMods_Click"/>
                                            <Button x:Name="BtnExportSettings" Content="設定をエクスポート" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,10" Click="ExportSettings_Click"/>
                                            <Button x:Name="BtnImportSettings" Content="設定をインポート" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,10" Click="ImportSettings_Click"/>
                                            <Button x:Name="BtnShowIntro" Content="機能紹介ガイド" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,10" Click="ShowIntro_Click"/>
                                            <Button x:Name="BtnRepairRoblox" Content="ClientSettings・読み取り専用解除" Style="{StaticResource DangerButton}" Height="38" Margin="0,0,10,10" Click="RepairRoblox_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= 初回起動時 機能紹介オーバーレイ ================= -->
            <Border x:Name="WelcomeOverlay" Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}" CornerRadius="16" Visibility="Collapsed">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" Width="640" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.7" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="LblWelcomeTitle" Text="AZQLAUNCHER へようこそ！" Foreground="{DynamicResource TextBrush}" FontSize="24" FontWeight="ExtraBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LblWelcomeSub" Text="主な機能のご紹介" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,0,20"/>

                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="LblFeat1Title" Text="⚡ FastFlags ＆ FPS上限解放" Foreground="{DynamicResource OkBrightBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="LblFeat1Desc" Text="ホワイトリスト準拠の安全設計で、FPS上限設定や描画エンジンの切り替えが可能です。" Foreground="{DynamicResource TextBodyBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="LblFeat2Title" Text="🎨 カーソル・死亡音・スカイボックス・フォントのカスタマイズ" Foreground="{DynamicResource InfoBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="LblFeat2Desc" Text="Windowsの現在のカーソル維持、クラシックカーソル、内蔵Oof音や自動OGG変換、スカイボックス・UIフォント変更に対応しています。" Foreground="{DynamicResource TextBodyBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="14" Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock x:Name="LblFeat3Title" Text="🌐 ブラウザ連携 ＆ 標準起動切替" Foreground="{DynamicResource PurpleBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="LblFeat3Desc" Text="Webブラウザからの直接起動と、ランチャーを通さない標準起動の切り替えに対応しています。" Foreground="{DynamicResource TextBodyBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnStartLauncher" Content="はじめる" Style="{StaticResource PrimaryButton}" Width="200" Height="44" FontSize="15" HorizontalAlignment="Right" Click="CloseWelcome_Click"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ================= 読み込み中 (Launching) オーバーレイ ================= -->
            <Border x:Name="LaunchOverlay" Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}" CornerRadius="16" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="LaunchSpinner" Width="68" Height="68" BorderThickness="12" CornerRadius="6" Margin="0,0,0,30" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" BorderBrush="{StaticResource AccentGradient}">
                        <Border.RenderTransform>
                            <RotateTransform Angle="15"/>
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStoryboard">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:2.2" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock x:Name="LblLaunching" Text="Robloxを起動しています..." Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4" Foreground="#FF5B7CFF" Background="{DynamicResource SurfaceRaisedBrush}" BorderThickness="0"/>
                    <Button x:Name="BtnCancelLaunch" Content="キャンセル" Style="{StaticResource SecondaryButton}" Width="140" Height="36" Margin="0,26,0,0" HorizontalAlignment="Center" Click="CancelLaunch_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>